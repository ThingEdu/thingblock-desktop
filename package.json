{
  "name": "thingblock-desktop",
  "version": "0.6.0-preview-20261104",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build:editor": "cross-env NODE_ENV=production npm --prefix ../thingblock-editor/packages/thingblock-gui run build:dev",
    "dev:editor": "npm --prefix ../thingblock-editor/packages/thingblock-gui run start",
    "dist": "tauri build",
    "dist:debug": "tauri build --debug",
    "stage:frontend": "bash scripts/stage-frontend.sh",
    "stage:frontend:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-frontend.ps1",
    "stage:sidecar": "bash scripts/stage-sidecar.sh",
    "stage:sidecar:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-sidecar.ps1",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "cross-env": "^7"
  }
}
